<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only: true black, as SableColors.base (light mode was removed, David 2026-10-29). -->
    <style name="Theme.Sable" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
    </style>
    <!-- The widget's settings: the home screen's wallpaper shows behind the live preview. -->
    <style name="Theme.Sable.WidgetSettings" parent="Theme.Sable">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
