<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, narrow and tall (2x2): the cover fills the card, a shade at the bottom carries the title, artist and
     play button. Without a cover the shade is hidden and the text takes the theme's colours (SableWidget). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <FrameLayout
        android:id="@+id/widget_art_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/widget_lion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="44dp"
            android:contentDescription="@null"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/widget_lion"
            android:tint="@color/w_accent" />

        <ImageView
            android:id="@+id/widget_shade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/widget_shade" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/widget_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:shadowColor="#73000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="2"
                android:text="@string/widget_idle_title"
                android:textColor="@color/w_on_art"
                android:textSize="16sp" />

            <TextView
                android:shadowColor="#73000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_artist"
                android:textColor="@color/w_on_art2"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="@string/widget_play"
            android:src="@drawable/ic_w_play" />
    </LinearLayout>
</FrameLayout>
