<?xml version="1.0" encoding="utf-8"?>
<!-- SABLE mark: an S sitting on a level line (every song brought to one level), inside a fine ring.
     Warm ivory on true black. Adaptive-icon foreground: 108 dp canvas, 66 dp safe zone. Same geometry as
     ui/Logo.kt (SableMark). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring -->
    <path
        android:pathData="M54,29 A25,25 0 1,1 53.99,29 Z"
        android:strokeColor="#59E8E1D3" android:strokeWidth="1.2" />

    <!-- S: two arcs meeting on the level line -->
    <path
        android:pathData="M61.8,40.5 A9,9 0 1,0 54,54 A9,9 0 1,1 46.2,67.5"
        android:strokeColor="#E8E1D3" android:strokeWidth="3.2" android:strokeLineCap="round" />

    <!-- Level line, fading at both ends -->
    <path android:pathData="M30,53.1 L78,53.1 L78,54.9 L30,54.9 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="30" android:startY="54" android:endX="78" android:endY="54">
                <item android:offset="0" android:color="#00E8E1D3" />
                <item android:offset="0.3" android:color="#E6E8E1D3" />
                <item android:offset="0.7" android:color="#E6E8E1D3" />
                <item android:offset="1" android:color="#00E8E1D3" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
